@typing.final
class CTX:
    r"""
    Context for nested CDT (Complex Data Type) operations.
    Used to specify the location of nested lists/maps within a record.
    """
    def __eq__(self, other: _native.CTX) -> builtins.bool:
        r"""
        Compare two CTX objects for equality.
        """
    @staticmethod
    def list_index(index: builtins.int) -> _native.CTX:
        r"""
        Lookup list by index offset.
        If the index is negative, the resolved index starts backwards from end of list.
        Examples: 0 = first item, 4 = fifth item, -1 = last item, -3 = third to last item.
        """
    @staticmethod
    def list_index_create(index: builtins.int, order: _native.ListOrderType, pad: builtins.bool) -> _native.CTX:
        r"""
        Create list with given type at index offset, given an order and pad.
        """
    @staticmethod
    def list_rank(rank: builtins.int) -> _native.CTX:
        r"""
        Lookup list by rank.
        0 = smallest value, N = Nth smallest value, -1 = largest value.
        """
    @staticmethod
    def list_value(value: typing.Any) -> _native.CTX:
        r"""
        Lookup list by value.
        """
    @staticmethod
    def map_index(index: builtins.int) -> _native.CTX:
        r"""
        Lookup map by index offset.
        If the index is negative, the resolved index starts backwards from end of list.
        """
    @staticmethod
    def map_rank(rank: builtins.int) -> _native.CTX:
        r"""
        Lookup map by rank.
        0 = smallest value, N = Nth smallest value, -1 = largest value.
        """
    @staticmethod
    def map_key(key: typing.Any) -> _native.CTX:
        r"""
        Lookup map by key.
        """
    @staticmethod
    def map_key_create(key: typing.Any, order: _native.MapOrder) -> _native.CTX:
        r"""
        Create map with given type at map key.
        """
    @staticmethod
    def map_value(value: typing.Any) -> _native.CTX:
        r"""
        Lookup map by value.
        Converts HashMap to BTreeMap (OrderedMap) for exact byte-level matching to ensure consistent serialization.
        """
    @staticmethod
    def all_children() -> _native.CTX:
        r"""
        Select all children (elements or entries) of the current collection level.

        Equivalent to calling ``all_children_with_filter`` with a constant
        ``true`` expression.  Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def all_children_with_filter(exp: _native.FilterExpression) -> _native.CTX:
        r"""
        Select all children of the current collection level that satisfy ``exp``.

        The expression is evaluated per child element.  Use loop-variable
        expressions (``FilterExpression.int_loop_var``,
        ``FilterExpression.float_loop_var``,
        ``FilterExpression.string_loop_var``,
        ``FilterExpression.map_loop_var``,
        ``FilterExpression.bool_loop_var``) inside ``exp`` to reference the
        current element.  Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def map_keys_in(keys: typing.Sequence[typing.Any]) -> _native.CTX:
        r"""
        Select map entries whose keys are in ``keys``.

        Requires Aerospike Server version >= 8.1.2.
        """
    @staticmethod
    def and_filter(exp: _native.FilterExpression) -> _native.CTX:
        r"""
        AND-combine the previous filter context with ``exp``. Used to
        stack additional predicates onto an ``all_children_with_filter``
        step.

        Requires Aerospike Server version >= 8.1.2.
        """
    @staticmethod
    def to_base64(ctx: typing.Sequence[_native.CTX]) -> builtins.str:
        r"""
        Encode a context array to base64 — pairs with :meth:`from_base64`.

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def from_base64(b64: builtins.str) -> builtins.list[_native.CTX]:
        r"""
        Restore a context array from the base64-encoded form produced by
        the matching :meth:`to_base64` helper.

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def to_bytes(ctx: typing.Sequence[_native.CTX]) -> bytes:
        r"""
        Pack a context array to the raw byte stream that :meth:`to_base64`
        encodes -- pairs with :meth:`from_bytes`.

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def from_bytes(bytes: typing.Sequence[builtins.int]) -> builtins.list[_native.CTX]:
        r"""
        Restore a context array from the raw byte stream that base64
        encodes.

        Requires Aerospike Server version >= 8.1.1.
        """

class CdtOperation:
    r"""
    CDT path expression operations for reading and writing nested CDT data.

    Requires Aerospike Server version >= 8.1.1.
    """
    @property
    def is_idempotent(self) -> builtins.bool:
        r"""
        ``True`` when re-sending this operation after an in-doubt attempt
        leaves the record as one application would. Reads are idempotent;
        every modify operation of this class is not. See
        :attr:`Operation.is_idempotent` for the rule.
        """
    @staticmethod
    def select_by_path(bin_name: builtins.str, flag: builtins.int, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Create a CDT path select operation.

        Reads nested CDT data identified by the given path context, returning
        result elements controlled by ``flag``.

        Args:
            bin_name: Name of the bin containing the top-level CDT.
            flag: Controls what is returned. Pass any combination of
                ``SelectFlags`` constants (e.g. ``SelectFlags.VALUE |
                SelectFlags.NO_FAIL``) — the resulting value is a plain
                ``int`` bitmask.
            ctx: Path into the CDT — one ``CTX`` per nesting level.

        Returns:
            A ``CdtOperation`` to pass to ``client.operate()``.

        Example::

            from aerospike_native import CdtOperation, CTX, SelectFlags
            op = CdtOperation.select_by_path(
                "inventory",
                SelectFlags.VALUE,
                [CTX.map_key("books"), CTX.list_index(0)],
            )
        """
    @staticmethod
    def modify_by_path(bin_name: builtins.str, flag: builtins.int, exp: _native.FilterExpression, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Create a CDT path modify operation.

        Writes to nested CDT data identified by the given path context, using
        ``exp`` to compute the new value.

        Args:
            bin_name: Name of the bin containing the top-level CDT.
            flag: Controls error-handling behavior. Pass any combination of
                ``ModifyFlags`` constants — the resulting value is a plain
                ``int`` bitmask.
            exp: Expression that produces the value to write.
            ctx: Path into the CDT — one ``CTX`` per nesting level.

        Returns:
            A ``CdtOperation`` to pass to ``client.operate()``.

        Example::

            from aerospike_native import CdtOperation, CTX, ModifyFlags, FilterExpression
            price_path = [CTX.map_key("books"), CTX.list_rank(0), CTX.map_key("price")]
            new_price = FilterExpression.float_val(9.99)
            op = CdtOperation.modify_by_path(
                "inventory",
                ModifyFlags.DEFAULT,
                new_price,
                price_path,
            )
        """
    @staticmethod
    def select_values(bin_name: builtins.str, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Select the *values* at every path-resolved location
        (``SelectFlags.VALUE``). Equivalent to
        ``CdtOperation.select_by_path(bin, SelectFlags.VALUE, ctx)``.

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def select_map_keys(bin_name: builtins.str, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Select the matching *map keys* (``SelectFlags.MAP_KEY``).

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def select_map_entries(bin_name: builtins.str, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Select map *key/value pairs* (``SelectFlags.MAP_KEY_VALUE``).

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def select_matching_tree(bin_name: builtins.str, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Select the *original tree shape* preserving only matching nodes
        (``SelectFlags.MATCHING_TREE``).

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def modify(bin_name: builtins.str, exp: _native.FilterExpression, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Modify with default flags, failing on type mismatches
        (``ModifyFlags.DEFAULT``).

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def modify_no_fail(bin_name: builtins.str, exp: _native.FilterExpression, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Modify with ``ModifyFlags.NO_FAIL`` so type-mismatched leaves are
        silently skipped instead of aborting the whole operation.

        Requires Aerospike Server version >= 8.1.1.
        """
    @staticmethod
    def remove(bin_name: builtins.str, ctx: typing.Sequence[_native.CTX]) -> _native.CdtOperation:
        r"""
        Remove the leaves resolved by a path. Equivalent to
        ``CdtOperation.modify_by_path(bin, ModifyFlags.DEFAULT, FilterExpression.remove_result(), ctx)``.

        Requires Aerospike Server version >= 8.1.1.
        """

class Client:
    @property
    def cluster_name(self) -> typing.Optional[builtins.str]:
        r"""
        Configured cluster name from the ``ClientPolicy`` used to build this
        client, or ``None`` when cluster-name validation was not requested.

        This is the client-side *expected* name (set via cluster-name
        validation), not a server-reported value; it reads a cached field
        with no network or lock cost.
