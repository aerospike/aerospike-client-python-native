    @staticmethod
    def b64_encode(bin_name: builtins.str, byte_offset: typing.Optional[builtins.int] = None, byte_size: typing.Optional[builtins.int] = None, invert_size: builtins.bool = False) -> _native.BitOperation:
        r"""
