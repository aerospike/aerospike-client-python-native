    @staticmethod
    def lscan(bin_name: builtins.str, bit_offset: builtins.int, bit_size: builtins.int, value: builtins.bool) -> _native.BitOperation:
        r"""
        Create a Bit lscan operation (scans left for value, read-only).
        """
    @staticmethod
    def rscan(bin_name: builtins.str, bit_offset: builtins.int, bit_size: builtins.int, value: builtins.bool) -> _native.BitOperation:
